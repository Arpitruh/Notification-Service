datasource db {
  provider = "postgresql"
  // Remove the url line completely
}

generator client {
  provider = "prisma-client-js"
}
enum Channel {
  email
  sms
  push
}

enum NotificationStatus {
  queued
  processing
  sent
  failed
  dead_letter
}

model Notification {
  id              String             @id @default(uuid())
  idempotency_key String             @unique
  recipient       String
  channel         Channel
  template_id     String
  payload_data    Json
  status          NotificationStatus @default(queued)
  attempts        Int                @default(0)
  priority        Int                @default(0)
  scheduled_for   DateTime?
  caller_service  String
  error_log       Json?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  @@index([idempotency_key])
  @@index([status])
}

model Suppression {
  id         String   @id @default(uuid())
  recipient  String
  channel    Channel
  reason     String
  created_at DateTime @default(now())

  @@unique([recipient, channel])
}
model Application {
  id          String @id @default(uuid())
  slug        String @unique
  name        String
  enabled     Boolean @default(true)
  created_at  DateTime @default(now())
  users       ApplicationUser[]
  templates   MailTemplate[]
  memberships DashboardMembership[]
}

model ApplicationUser {
  id             String @id @default(uuid())
  application_id String
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  external_id    String
  email          String?
  name           String?
  enabled        Boolean @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([application_id, external_id])
  @@index([application_id])
}

model MailTemplate {
  id                 String @id @default(uuid())
  application_id     String
  application        Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  slug               String
  subject            String
  html               String
  required_variables Json @default("[]")
  version            Int @default(1)
  published          Boolean @default(false)
  archived           Boolean @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([application_id, slug])
  @@index([application_id])
}

model DashboardMembership {
  id             String @id @default(uuid())
  application_id String
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  auth_subject   String
  role           String @default("viewer")
  created_at     DateTime @default(now())

  @@unique([application_id, auth_subject])
  @@index([auth_subject])
}

model DashboardAudit {
  id             String @id @default(uuid())
  application_id String
  actor          String
  action         String
  resource_id    String?
  created_at     DateTime @default(now())

  @@index([application_id, created_at])
}
