datasource db {
  provider = "postgresql"
  // Remove the url line completely
}

generator client {
  provider = "prisma-client-js"
}
enum Channel {
  email
  sms
  push
}

enum NotificationStatus {
  queued
  processing
  sent
  failed
  dead_letter
  pending
  retry_scheduled
  expired
  cancelled
  suppressed
  unknown
}

enum AttemptOutcome {
  started
  accepted
  transient_failure
  permanent_failure
  unknown
}

model Notification {
  id              String             @id @default(uuid())
  idempotency_key String             @unique
  recipient       String
  channel         Channel
  template_id     String
  payload_data    Json
  status          NotificationStatus @default(queued)
  attempts        Int                @default(0)
  priority        Int                @default(0)
  scheduled_for   DateTime?
  caller_service  String
  error_log       Json?
  application_id  String?
  payload_hash    String?
  rendered_email  Json?
  provider_message_id String?
  expires_at      DateTime?
  locked_by       String?
  locked_until    DateTime?
  delivery_attempts NotificationAttempt[]
  outbox_events    NotificationOutbox[]
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  @@index([idempotency_key])
  @@index([status])
  @@index([status, scheduled_for])
  @@index([application_id, created_at])
}

model NotificationOutbox {
  id              String @id @default(uuid())
  notification_id String
  notification    Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  next_attempt_at DateTime @default(now())
  claimed_until   DateTime?
  attempts        Int @default(0)
  last_error      String?
  published_at    DateTime?
  created_at      DateTime @default(now())
  @@index([published_at, next_attempt_at])
  @@index([notification_id])
  @@map("notification_outbox")
}

model NotificationAttempt {
  id                  String @id @default(uuid())
  notification_id     String
  notification        Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  attempt_number      Int
  provider            String
  provider_message_id String?
  outcome             AttemptOutcome @default(started)
  retryable           Boolean?
  error_code          String?
  error_message       String?
  started_at          DateTime @default(now())
  finished_at         DateTime?
  @@index([notification_id, started_at])
  @@map("notification_attempt")
}

model Suppression {
  id         String   @id @default(uuid())
  recipient  String
  channel    Channel
  reason     String
  created_at DateTime @default(now())

  @@unique([recipient, channel])
}
model Application {
  id          String @id @default(uuid())
  slug        String @unique
  name        String
  enabled     Boolean @default(true)
  dashboard_url String?
  welcome_enabled Boolean @default(false)
  welcome_template String @default("welcome")
  credentials ApplicationCredential[]
  created_at  DateTime @default(now())
  users       ApplicationUser[]
  templates   MailTemplate[]
  memberships DashboardMembership[]
}

model ApplicationUser {
  id             String @id @default(uuid())
  application_id String
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  external_id    String
  email          String?
  name           String?
  enabled        Boolean @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([application_id, external_id])
  @@index([application_id])
}

model MailTemplate {
  id                 String @id @default(uuid())
  application_id     String
  application        Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  slug               String
  subject            String
  html               String
  required_variables Json @default("[]")
  version            Int @default(1)
  published          Boolean @default(false)
  archived           Boolean @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([application_id, slug])
  @@index([application_id])
}

model DashboardMembership {
  id             String @id @default(uuid())
  application_id String
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  auth_subject   String
  role           String @default("viewer")
  created_at     DateTime @default(now())

  @@unique([application_id, auth_subject])
  @@index([auth_subject])
}

model DashboardAudit {
  id             String @id @default(uuid())
  application_id String
  actor          String
  action         String
  resource_id    String?
  created_at     DateTime @default(now())

  @@index([application_id, created_at])
}

model ApplicationCredential {
  id String @id @default(uuid())
  application_id String
  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  key_hash String @unique
  prefix String
  label String
  created_at DateTime @default(now())
  revoked_at DateTime?
  @@index([application_id])
}
