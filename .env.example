# ---- Server ----
# Port the HTTP server listens on. Render sets PORT automatically; locally defaults to 4000.
PORT=4000

# ---- Database (Postgres / Neon) ----
# Full connection string. Neon requires TLS (enforced in code).
DATABASE_URL="postgresql://user:password@host/dbname"

# ---- Redis (BullMQ queue) ----
# In production point these at a managed Redis instance. On Render, use the
# managed Redis connection details (host/port), or a full REDIS_URL if you
# adapt the config to parse one.
REDIS_HOST="localhost"
REDIS_PORT=6379

# ---- Gmail API provider (HTTPS, no domain needed) ----
# Enable ONLY after you have authorized the sender via Google OAuth 2.0.
# Gmail API requires the minimal https://www.googleapis.com/auth/gmail.send scope.
# Gmail's External + Testing OAuth refresh tokens generally expire after 7 days.
# Never commit real OAuth credentials.
# EMAIL_PROVIDER=gmail
# GMAIL_FROM=arpit.yadav.projects@gmail.com
# GMAIL_CLIENT_ID=<OAuth web app client ID>
# GMAIL_CLIENT_SECRET=<OAuth client secret>
# GMAIL_REFRESH_TOKEN=<authorized Gmail sender's refresh token>

# ---- Email provider (SMTP) ----
# Gmail example: port 465 = implicit TLS (SMTP_SECURE=true). Use a Google
# "App Password" (requires 2-Step Verification), not the account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="you@example.com"
SMTP_PASS="your_app_password"
# The From address should match SMTP_USER for Gmail to accept the send.
MAIL_FROM="Notification Service <you@example.com>"

# ---- SMS provider (Twilio) ----
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# ---- Application API keys (bootstrap, until dashboard-managed credentials ship) ----
# JSON map of application IDs to strong random secrets (>=32 characters each).
# REQUIRED in production, never commit real keys.
# APP_API_KEYS='{"my-app":"replace-with-a-random-secret-at-least-32-chars"}'
# Client request header: X-API-Key: <the secret>
# Each key is tied to the app ID; X-Caller-Service header is ignored.
APP_API_KEYS='{}'

# ---- Dashboard identity and authorization ----
# Existing Auth Service. Keep the introspection backend key server-side.
AUTH_SERVICE_URL="https://login-service-8akx.onrender.com"
AUTH_SERVICE_KEY=""
# Comma-separated Auth Service subject/user IDs of platform operators.
# Set at least one subject before initial application creation.
DASHBOARD_ADMIN_SUBJECTS=""

# Opt-in public demo. Set production hostname and free Turnstile keys before enabling.
DEMO_LIVE_ENABLED=false
DEMO_TURNSTILE_SITE_KEY=
DEMO_TURNSTILE_SECRET=
DEMO_HOSTNAME=
